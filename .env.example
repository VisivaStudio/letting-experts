# Supabase Configuration
# Get these values from your Supabase project settings at https://supabase.com/dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Calendar Integration (Optional)
# Leave empty if not using calendar sync
GOOGLE_CALENDAR_API_KEY=your-google-api-key
OUTLOOK_CLIENT_ID=your-outlook-client-id

# WhatsApp Integration (Optional)
WHATSAPP_BUSINESS_API_TOKEN=your-whatsapp-token
WHATSAPP_BUSINESS_ACCOUNT_ID=your-account-id

# Email Configuration (Optional)
EMAIL_PROVIDER=sendgrid
EMAIL_PROVIDER_KEY=your-email-provider-key

# Analytics (Optional)
ANALYTICS_ENABLED=false
SENTRY_DSN=your-sentry-dsn
